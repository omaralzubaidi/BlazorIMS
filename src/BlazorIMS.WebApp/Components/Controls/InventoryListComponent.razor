@using BlazorIMS.CoreBusiness
@using BlazorIMS.UseCases.Inventories.interfaces
@using BlazorIMS.WebApp.Components.Pages

@inject IViewInventoriesByNameUseCase viewInventoriesByNameUseCase
@inject NavigationManager navigationManager

@if(inventories is not null)
{
    <table class="table">
      <thead>
        <th>Inventory Name</th>
        <th>Quantity</th>
        <th>Price</th>
        <th></th>
      </thead>
      <tbody>
        @foreach(var inv in inventories)
        {
          <InventoryListItemComponent inventory="inv"></InventoryListItemComponent>
        }
      </tbody>
    </table>
}
@code {
    [Parameter]
    public string? inventorySearchTerm{get; set;} = string.Empty;
    private List<Inventory>? inventories;
    protected override async Task OnParametersSetAsync()
    {
      inventories = (await viewInventoriesByNameUseCase.ExecuteAsync(inventorySearchTerm??string.Empty)).ToList();
    }
  
}
