@page "/purchase"

@rendermode InteractiveServer

@using BlazorIMS.UseCases.Inventories.interfaces
@using static BlazorIMS.WebApp.Components.Controls.Common.AutoCompleteComponent
@inject IViewInventoriesByNameUseCase viewInventoriesByNameUseCase

<h3>Purchase Inventory</h3>
<br />

<AutoCompleteComponent Label="Inventory" SearchFunction="SearchInventory" onSelectedItem="HandleSelectedItem"></AutoCompleteComponent>
<br>
@selectedItem?.Name
@code {
    private ItemViewModle? selectedItem;
    private List<ItemViewModle> SearchInventory(string name)
    {
        var inventories = viewInventoriesByNameUseCase.ExecuteAsync(name).GetAwaiter().GetResult();

        return inventories.Select(i => new ItemViewModle{Id = i.InventoryId, Name = i.InventoryName}).ToList();
    }

    private void HandleSelectedItem(ItemViewModle item)
    {
      this.selectedItem = item;
    }

}
