@page "/inventories"
@using BlazorIMS.CoreBusiness
@using BlazorIMS.UseCases.Inventories.interfaces
@using BlazorIMS.WebApp.Components.Controls
@using Microsoft.AspNetCore.Mvc.ViewEngines

<h3>Inventories List</h3>
<br>
<SearchComponent onSearch="HandleInventorySearch"></SearchComponent>
<br>
<InventoryListComponent inventorySearchTerm="@searchTerm"></InventoryListComponent>

<a href="/addinventory" class="btn btn-primary">Add Inventory</a>

@code {
    private string? searchTerm;
    private async Task HandleInventorySearch(string searchTerm)
    {
        this.searchTerm = searchTerm;
    }

}
